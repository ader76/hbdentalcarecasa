# Copier en .env.local. Ne JAMAIS committer de vraies valeurs.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (anon / publishable) : peut être exposée au navigateur, protégée par RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (routes API, scripts). Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres directe : scripts de sauvegarde/restauration et tests uniquement.
SUPABASE_DB_URL=
# Sauvegardes chiffrées : phrase secrète (32 caractères minimum), conservée hors du serveur.
BACKUP_PASSPHRASE=
